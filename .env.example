# Ask the LLM to rate its confidence for each extracted field (true/false)
# Appends pcr_confidence_prompt.md to the base prompt when enabled
WITH_CONFIDENCE=false

# Max LLM retry attempts when post-parse validation fails (date/time consistency checks)
MAX_PARSE_RETRIES=3

# Parser backend: 'openai' (default) or 'azure'
# openai: uses GPT-4o Vision (converts PDF to images)
# azure:  uses Azure Document Intelligence OCR + GPT-4o-mini text (cheaper)
PARSER_BACKEND=openai

# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Azure Document Intelligence (required when PARSER_BACKEND=azure)
# Get these from your Azure portal → Document Intelligence resource → Keys and Endpoint
AZURE_DI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DI_KEY=your_azure_di_key_here

# Supabase Configuration
# Get these from your Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Anon key (public, subject to RLS policies)
SUPABASE_KEY=your_supabase_anon_key_here

# Service role key (secret — bypasses RLS, required for Storage uploads)
# Never expose this in client-side code. Safe to use in server-side .env files.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# PCR Polling Service Configuration
# Directory to watch for incoming PDF files
# Example: /path/to/watch/directory or ./pdfs
WATCH_DIR=/path/to/watch/directory

# How often to check for new PDF files (in seconds)
# Default: 30 seconds
POLL_INTERVAL_SECONDS=30

# Yahoo Mail Poller Configuration
# Yahoo email address for receiving fax notifications
YAHOO_EMAIL=your_email@yahoo.com

# Yahoo app-specific password (NOT your regular password)
# Generate one at: https://login.yahoo.com/account/security/app-passwords
YAHOO_PASSWORD=your_app_specific_password_here

# Directory to save email attachments (can use same as WATCH_DIR)
# If not set, will use WATCH_DIR
EMAIL_SAVE_DIR=/path/to/watch/directory

# How often to check for new emails during daytime (in seconds)
# Default: 900 seconds (15 minutes)
DAY_POLL_INTERVAL_SECONDS=900

# How often to check for new emails during nighttime (in seconds)
# Default: 3600 seconds (1 hour)
NIGHT_POLL_INTERVAL_SECONDS=3600

# Night mode hours (24-hour format, 0-23)
# Night mode uses slower polling interval
NIGHT_START_HOUR=23  # 11 PM
NIGHT_END_HOUR=6     # 6 AM
